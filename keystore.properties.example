# Copie para keystore.properties (que é ignorado pelo Git) e preencha.
# Gere o keystore com:
#   keytool -genkeypair -v -keystore keystore/docreader.jks -alias docreader \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=../keystore/docreader.jks
storePassword=troque-me
keyAlias=docreader
keyPassword=troque-me
